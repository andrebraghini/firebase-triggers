{
  "name": "firebase-triggers",
  "version": "3.0.0",
  "description": "TypeScript decorators to assign Firebase triggers to regular methods",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/cjs/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    }
  },
  "files": [
    "lib/**/*",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsc -p tsconfig.test.json && c8 --reporter=html --reporter=json --reporter=text node --test \"lib-test/src/**/*.spec.js\"",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:package-json && npm run build:fix-esm",
    "clean": "rm -rf lib",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:package-json": "node scripts/write-package-jsons.js",
    "build:fix-esm": "node scripts/fix-esm-extensions.js",
    "smoke:pack": "node scripts/smoke-pack.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"**/*.spec.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrebraghini/firebase-triggers.git"
  },
  "keywords": [
    "firebase",
    "firestore",
    "cloud functions",
    "serverless",
    "pubsub",
    "trigger",
    "decorator"
  ],
  "author": "Andre Braghini",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andrebraghini/firebase-triggers/issues"
  },
  "homepage": "https://github.com/andrebraghini/firebase-triggers#readme",
  "dependencies": {
    "ajv": "^8.17.1",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0"
  },
  "peerDependencies": {
    "firebase-admin": "^13.0.0 || ^14.0.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "c8": "^10.1.3",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
